// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                              String             @id @default(cuid())
  fullName                        String             @default("")
  email                           String             @unique @default("")
  password                        String
  phone                           String             @default("")
  address                         String             @default("")
  role                            String?            @default("user")
  createdAt                       DateTime?          @default(now())
  updatedAt                       DateTime?          @default(now())
  rating                          rating?            @relation("User_rating", fields: [ratingId], references: [id])
  ratingId                        String?            @map("rating")
  favoris                         favoris[]          @relation("User_favoris")
  comment                         comment[]          @relation("User_comment")
  reviews                         reviewUsers[]      @relation("User_reviews")
  from_Invoice_user               Invoice[]          @relation("Invoice_user")
  from_responsiveConfig_updatedBy responsiveConfig[] @relation("responsiveConfig_updatedBy")
  from_rating_user                rating[]           @relation("rating_user")
  from_favoris_user               favoris[]          @relation("favoris_user")
  from_comment_user               comment[]          @relation("comment_user")
  from_reviewUsers_userId         reviewUsers[]      @relation("reviewUsers_userId")

  @@index([ratingId])
}

model Agency {
  id                                String             @id @default(cuid())
  agencyFullName                    String             @default("")
  agencyAvatar_id                   String?
  agencyAvatar_filesize             Int?
  agencyAvatar_width                Int?
  agencyAvatar_height               Int?
  agencyAvatar_extension            String?
  agencyPhoneNumber                 String             @default("")
  agencyAddress                     String             @default("")
  agencyTaxNumber                   String             @default("")
  agencyCompanyType                 String?
  cars                              Car[]              @relation("Agency_cars")
  createdAt                         DateTime?          @default(now())
  updatedAt                         DateTime?          @default(now())
  receivedReviews                   reviewUsers[]      @relation("Agency_receivedReviews")
  from_Car_agency                   Car[]              @relation("Car_agency")
  from_Invoice_agency               Invoice[]          @relation("Invoice_agency")
  from_carSpecification_agency      carSpecification[] @relation("carSpecification_agency")
  from_contactInquiry_relatedAgency contactInquiry[]   @relation("contactInquiry_relatedAgency")
  from_carListing_agency            carListing[]       @relation("carListing_agency")
  from_reviewUsers_agencyId         reviewUsers[]      @relation("reviewUsers_agencyId")
}

model Car {
  id                        String             @id @default(cuid())
  name                      String             @default("")
  model                     String
  year                      Int
  price                     Int
  color                     String?
  bodyType                  String?
  engineType                String?
  horsepower                Int?
  torque                    Int?
  topSpeed                  Int?
  acceleration              String             @default("")
  transmission              String?
  drivetrain                String?
  fuelCapacity              Float?
  fuelEconomyCity           Float?
  fuelEconomyHighway        Float?
  fuelEconomyCombined       Float?
  emissionsRating           String             @default("")
  airbags                   Int?
  abs                       Boolean            @default(false)
  tractionControl           Boolean            @default(false)
  laneAssist                Boolean            @default(false)
  adaptiveCruiseControl     Boolean            @default(false)
  blindSpotMonitor          Boolean            @default(false)
  rearViewCamera            Boolean            @default(false)
  parkingSensors            Boolean            @default(false)
  autonomousDrivingLevel    String?
  seats                     Int?
  seatMaterial              String?
  heatedSeats               Boolean            @default(false)
  ventilatedSeats           Boolean            @default(false)
  sunroof                   Boolean            @default(false)
  climateControl            String?
  infotainmentSystem        String             @default("")
  touchscreenSize           Float?
  wirelessCharging          Boolean            @default(false)
  appleCarPlay              Boolean            @default(false)
  androidAuto               Boolean            @default(false)
  wheels                    String?
  wheelSize                 Float?
  ledHeadlights             Boolean            @default(false)
  fogLights                 Boolean            @default(false)
  tintedWindows             Boolean            @default(false)
  cargoCapacity             Float?
  towingCapacity            Float?
  roofRack                  Boolean            @default(false)
  trailerHitch              Boolean            @default(false)
  bluetooth                 Boolean            @default(false)
  wifiHotspot               Boolean            @default(false)
  usbPorts                  Int?
  speakerSystem             String             @default("")
  agency                    Agency[]           @relation("Car_agency")
  rating                    rating[]           @relation("Car_rating")
  favoris                   favoris[]          @relation("Car_favoris")
  comment                   comment[]          @relation("Car_comment")
  status                    String?            @default("available")
  listedDate                DateTime?          @default(now())
  warrantyYears             Int?
  images_id                 String?
  images_filesize           Int?
  images_width              Int?
  images_height             Int?
  images_extension          String?
  videoURL                  String             @default("")
  insuranceStatus           String?
  registrationValidUntil    DateTime?
  from_Agency_cars          Agency[]           @relation("Agency_cars")
  from_Invoice_car          Invoice[]          @relation("Invoice_car")
  from_carSpecification_car carSpecification[] @relation("carSpecification_car")
  from_carListing_car       carListing[]       @relation("carListing_car")
  from_rating_car           rating[]           @relation("rating_car")
  from_favoris_car          favoris[]          @relation("favoris_car")
  from_comment_car          comment[]          @relation("comment_car")
}

model Invoice {
  id           String   @id @default(cuid())
  orderId      String   @default("")
  taxOnValue   String   @default("")
  BaseTaxValue String   @default("")
  NetValue     String   @default("")
  status       Boolean  @default(false)
  agency       Agency[] @relation("Invoice_agency")
  user         User[]   @relation("Invoice_user")
  car          Car[]    @relation("Invoice_car")
}

model setting {
  id              String  @id @default(cuid())
  brand           String
  bodyType        String?
  engineType      String?
  transmission    String?
  drivetrain      String?
  climateControl  String?
  wheels          String?
  heatedSeats     Boolean @default(false)
  ventilatedSeats Boolean @default(false)
  sunroof         Boolean @default(false)
  bluetooth       Boolean @default(false)
  wifiHotspot     Boolean @default(false)
  appleCarPlay    Boolean @default(false)
  androidAuto     Boolean @default(false)
  airbags         Int?
  warrantyYears   Int?
  fuelCapacity    Float?
}

model responsiveConfig {
  id                String    @id @default(cuid())
  name              String    @unique @default("")
  isMobileOptimized Boolean   @default(true)
  breakpoints       String?
  designFeatures    String?
  theme             String?   @default("light")
  createdAt         DateTime? @default(now())
  updatedAt         DateTime? @default(now())
  updatedBy         User?     @relation("responsiveConfig_updatedBy", fields: [updatedById], references: [id])
  updatedById       String?   @map("updatedBy")

  @@index([updatedById])
}

model mediaUpload {
  id                  String    @id @default(cuid())
  title               String    @default("")
  description         String    @default("")
  mediaType           String
  mediaFile_id        String?
  mediaFile_filesize  Int?
  mediaFile_width     Int?
  mediaFile_height    Int?
  mediaFile_extension String?
  videoURL            String    @default("")
  createdAt           DateTime? @default(now())
  updatedAt           DateTime? @default(now())
}

model carSpecification {
  id                 String    @id @default(cuid())
  car                Car?      @relation("carSpecification_car", fields: [carId], references: [id])
  carId              String?   @map("car")
  agency             Agency?   @relation("carSpecification_agency", fields: [agencyId], references: [id])
  agencyId           String?   @map("agency")
  engineType         String?
  horsepower         Int?
  torque             Int?
  topSpeed           Int?
  acceleration       String    @default("")
  transmission       String?
  drivetrain         String?
  fuelCapacity       Float?
  fuelEconomyCity    Float?
  fuelEconomyHighway Float?
  emissionsRating    String    @default("")
  airbags            Int?
  warrantyYears      Int?
  images_id          String?
  images_filesize    Int?
  images_width       Int?
  images_height      Int?
  images_extension   String?
  listedDate         DateTime? @default(now())

  @@index([carId])
  @@index([agencyId])
}

model contactInquiry {
  id              String    @id @default(cuid())
  fullName        String    @default("")
  phoneNumber     String    @default("")
  message         String    @default("")
  inquiryType     String?   @default("general")
  relatedAgency   Agency?   @relation("contactInquiry_relatedAgency", fields: [relatedAgencyId], references: [id])
  relatedAgencyId String?   @map("relatedAgency")
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @default(now())

  @@index([relatedAgencyId])
}

model carSearchFilter {
  id          String  @id @default(cuid())
  searchQuery String  @default("")
  model       String?
  year        Int?
  priceMin    Int?
  priceMax    Int?
  color       String?
}

model carListing {
  id               String    @id @default(cuid())
  title            String    @default("")
  description      String    @default("")
  price            Int
  status           String?   @default("available")
  car              Car?      @relation("carListing_car", fields: [carId], references: [id])
  carId            String?   @map("car")
  agency           Agency?   @relation("carListing_agency", fields: [agencyId], references: [id])
  agencyId         String?   @map("agency")
  images_id        String?
  images_filesize  Int?
  images_width     Int?
  images_height    Int?
  images_extension String?
  videoURL         String    @default("")
  listedDate       DateTime? @default(now())
  featured         Boolean   @default(false)

  @@index([carId])
  @@index([agencyId])
}

model rating {
  id               String    @id @default(cuid())
  reviewText       String    @default("")
  rating           Int
  user             User?     @relation("rating_user", fields: [userId], references: [id])
  userId           String?   @map("user")
  car              Car?      @relation("rating_car", fields: [carId], references: [id])
  carId            String?   @map("car")
  createdAt        DateTime? @default(now())
  from_User_rating User[]    @relation("User_rating")
  from_Car_rating  Car[]     @relation("Car_rating")

  @@index([userId])
  @@index([carId])
}

model favoris {
  id                String   @id @default(cuid())
  user              User?    @relation("favoris_user", fields: [userId], references: [id])
  userId            String?  @map("user")
  car               Car?     @relation("favoris_car", fields: [carId], references: [id])
  carId             String?  @map("car")
  addedDate         DateTime @default(now())
  from_User_favoris User[]   @relation("User_favoris")
  from_Car_favoris  Car[]    @relation("Car_favoris")

  @@index([userId])
  @@index([carId])
}

model comment {
  id                String   @id @default(cuid())
  content           String   @default("")
  creationDate      DateTime @default(now())
  user              User?    @relation("comment_user", fields: [userId], references: [id])
  userId            String?  @map("user")
  car               Car?     @relation("comment_car", fields: [carId], references: [id])
  carId             String?  @map("car")
  from_User_comment User[]   @relation("User_comment")
  from_Car_comment  Car[]    @relation("Car_comment")

  @@index([userId])
  @@index([carId])
}

model reviewUsers {
  id                          String    @id @default(cuid())
  userId                      User?     @relation("reviewUsers_userId", fields: [userIdId], references: [id])
  userIdId                    String?   @map("userId")
  agencyId                    Agency?   @relation("reviewUsers_agencyId", fields: [agencyIdId], references: [id])
  agencyIdId                  String?   @map("agencyId")
  rating                      Int
  title                       String    @default("")
  content                     String    @default("")
  reviewDate                  DateTime? @default(now())
  createdAt                   DateTime? @default(now())
  updatedAt                   DateTime? @default(now())
  from_User_reviews           User[]    @relation("User_reviews")
  from_Agency_receivedReviews Agency[]  @relation("Agency_receivedReviews")

  @@index([userIdId])
  @@index([agencyIdId])
}
